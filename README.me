✅ /exemple/handlers/withJquery.js — 1 function: withJquery()
✅ /exemple/sources/events.js — 2 functions: add(), multiply()
✅ /exemple/sources/formatNumber.js — 1 function: formatNumber()
📚 lib: /js_vendor/src/jquery.min.js → "jquery.min"
